RewriteEngine On
RewriteBase /

# 1. Stop rewrite for any existing static file or directory (CSS, JS, Fonts, Images)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 2. Exclude next_assets and _next from any page rewrites
RewriteRule ^next_assets/ - [L]
RewriteRule ^_next/ - [L]

# 3. Clean URLs: if path.html exists, serve it
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^/]+)/?$ $1.html [L]

# 4. Clean URLs: if path/index.html exists, serve it
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*)/?$ $1/index.html [L]
