model MainsSubmission {
  id              String                @id @default(uuid()) @db.Uuid
  userId          String                @map("user_id") @db.Uuid
  mainsQuestionId String                @map("mains_question_id") @db.Uuid
  status          MainsSubmissionStatus @default(DRAFT)
  ocrRetryCount   Int                   @default(0) @map("ocr_retry_count")
  ocrError        String?               @map("ocr_error")
  evalRetryCount  Int                   @default(0) @map("eval_retry_count")
  evalError       String?               @map("eval_error")
  submittedAt     DateTime?             @map("submitted_at")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  mainsQuestion MainsQuestion     @relation(fields: [mainsQuestionId], references: [id], onDelete: Restrict)
  answers       MainsAnswer[]
  evaluations   MainsEvaluation[]

  @@index([userId, submittedAt(sort: Desc)])
  @@index([mainsQuestionId])
  @@index([userId, status])
  @@map("mains_submissions")
}

model MainsAnswer {
  id            String   @id @default(uuid()) @db.Uuid
  submissionId  String   @map("submission_id") @db.Uuid
  version       Int      @default(1)
  extractedText String?  @map("extracted_text")
  wordCount     Int      @default(0) @map("word_count")
  imageUrl      String?  @map("image_url")
  imageUrls     Json?    @map("image_urls")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  submission  MainsSubmission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  evaluations MainsEvaluation[]

  @@unique([submissionId, version])
  @@map("mains_answers")
}

model MainsEvaluation {
  id             String   @id @default(uuid()) @db.Uuid
  submissionId   String   @map("submission_id") @db.Uuid
  answerId       String   @map("answer_id") @db.Uuid
  score          Decimal  @db.Decimal(5, 2)
  maxScore       Decimal  @map("max_score") @db.Decimal(5, 2)
  relevanceScore Decimal? @map("relevance_score") @db.Decimal(5, 2)
  feedbackJson   Json     @map("feedback_json")
  evaluationMeta Json?    @map("evaluation_meta")
  evaluatedAt    DateTime @default(now()) @map("evaluated_at")

  submission MainsSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
