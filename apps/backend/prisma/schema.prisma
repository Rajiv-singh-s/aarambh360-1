// Aarambh360 — Canonical Production Database Schema (Step 3)
// PostgreSQL + Prisma | Domain-first design

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserRole {
  USER
  EDITOR
  MODERATOR
  ADMIN
}

enum PreparationLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ExamStageType {
  PRELIMS
  MAINS
  INTERVIEW
}

enum GsPaper {
  GS1
  GS2
  GS3
  GS4
  CSAT
  ESSAY
  GENERAL
}

enum QuestionType {
  MCQ_SINGLE
  MCQ_MULTI
  ASSERTION_REASON
  PYQ_PRELIMS
  PYQ_MAINS
  MAINS_DESCRIPTIVE
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  EXPERT
}

enum PublishStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum ContentSourceType {
  NCERT
  PYQ
  EDITORIAL
  LEGACY_RTDB
  LEGACY_FIRESTORE
  USER_GENERATED
}

enum QuizType {
  PRACTICE
  MOCK
  MICRO
  PYQ
  CUSTOM
}

enum QuizAttemptStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
  TIMED_OUT
}

enum MainsSubmissionStatus {
  DRAFT
  SUBMITTED
  EVALUATING
  EVALUATED
  FAILED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum BillingProvider {
  RAZORPAY
  GOOGLE_PLAY
  APPLE_APP_STORE
  MANUAL
}

enum StreakType {
  MCQ
  STUDY
  MAINS
  COMBINED
}

enum StudyActivityType {
  LESSON
  QUIZ
  MAINS
  CURRENT_AFFAIRS
  REVISION
  PYQ
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  PUBLISH
  ARCHIVE
  RESTORE
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum BookmarkTargetType {
  QUESTION
  LESSON
  ARTICLE
  MAINS_QUESTION
}

enum RagDocumentType {
  NCERT
  MODEL_ANSWER
  SYLLABUS
  EDITORIAL
  PYQ_ANSWER
  RUBRIC
}

// =============================================================================
// 1. IDENTITY
// =============================================================================

model User {
  id               String    @id @default(uuid()) @db.Uuid
  firebaseUid      String    @unique @map("firebase_uid")
  email            String?   @unique
  phone            String?   @unique
  role             UserRole  @default(USER)
  profileCompleted Boolean   @default(false) @map("profile_completed")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  profile                Profile?
  preferences            UserPreference?
  onboarding             OnboardingProgress?
  examPreferences        UserExamPreference[]
  quizAttempts           QuizAttempt[]
  questionAttempts       QuestionAttempt[]
  lessonProgress         LessonProgress[]
  topicProgress          TopicProgress[]
  studySessions          StudySession[]
  dailyActivities        DailyActivity[]
  streaks                UserStreak[]
  bookmarks              Bookmark[]
  mistakes               Mistake[]
  savedQuestions         SavedQuestion[]
  mainsSubmissions       MainsSubmission[]
  subscriptions          Subscription[]
  entitlements           UserEntitlement[]
  usageRecords           UsageRecord[]
  deviceTokens           DeviceToken[]
  notificationLogs       NotificationLog[]
  learningEvents         LearningEvent[]
  questionReports        QuestionReport[]
  dailyChallenges        DailyChallengeQuestion[]
  articleBookmarks       ArticleBookmark[]
  auditLogs              AuditLog[]               @relation("AuditActor")
  contentRevisions       ContentRevision[]
  dailyChallengeAttempts DailyChallengeAttempt[]

  @@index([firebaseUid])
  @@index([email])
  @@index([deletedAt])
  @@map("users")
}

model Profile {
  id                String            @id @default(uuid()) @db.Uuid
  userId            String            @unique @map("user_id") @db.Uuid
  name              String
  dateOfBirth       DateTime?         @map("date_of_birth") @db.Date
  gender            String?
  avatarUrl         String?           @map("avatar_url")
  targetYear        Int?              @map("target_year")
  preparationLevel  PreparationLevel? @map("preparation_level")
  dailyStudyMinutes Int?              @map("daily_study_minutes")
  bio               String?
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model UserPreference {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @unique @map("user_id") @db.Uuid
  theme                String   @default("system")
  language             String   @default("en")
  pushNotifications    Boolean  @default(true) @map("push_notifications")
  emailNotifications   Boolean  @default(true) @map("email_notifications")
  streakReminders      Boolean  @default(true) @map("streak_reminders")
  currentAffairsAlerts Boolean  @default(true) @map("current_affairs_alerts")
  mainsEvalAlerts      Boolean  @default(true) @map("mains_eval_alerts")
  quizReminders        Boolean  @default(true) @map("quiz_reminders")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model OnboardingProgress {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @unique @map("user_id") @db.Uuid
  currentStep Int       @default(0) @map("current_step")
  completed   Boolean   @default(false)
  completedAt DateTime? @map("completed_at")
  metadata    Json?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("onboarding_progress")
}

model UserExamPreference {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  examId     String   @map("exam_id") @db.Uuid
  isPrimary  Boolean  @default(false) @map("is_primary")
  targetYear Int?     @map("target_year")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([userId, examId])
  @@index([userId, isPrimary])
  @@map("user_exam_preferences")
}

// =============================================================================
// 2. EXAM STRUCTURE
// =============================================================================

model Exam {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  stages           ExamStage[]
  subjects         Subject[]
  syllabusNodes    SyllabusNode[]
  userPreferences  UserExamPreference[]
  questions        Question[]
  quizzes          Quiz[]
  mainsQuestions   MainsQuestion[]
  articleMappings  ArticleExamMapping[]
  cutOffRecords    CutOffRecord[]
  examInfoSections ExamInfoSection[]

  @@map("exams")
}

model ExamStage {
  id          String        @id @default(uuid()) @db.Uuid
  examId      String        @map("exam_id") @db.Uuid
  stageType   ExamStageType @map("stage_type")
  name        String
  description String?
  sortOrder   Int           @default(0) @map("sort_order")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([examId, stageType])
  @@index([examId, sortOrder])
  @@map("exam_stages")
}

model Subject {
  id            String        @id @default(uuid()) @db.Uuid
  examId        String        @map("exam_id") @db.Uuid
  code          String
  name          String
  gsPaper       GsPaper?      @map("gs_paper")
  iconUrl       String?       @map("icon_url")
  description   String?
  sortOrder     Int           @default(0) @map("sort_order")
  publishStatus PublishStatus @default(DRAFT) @map("publish_status")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  deletedAt     DateTime?     @map("deleted_at")

  exam           Exam            @relation(fields: [examId], references: [id], onDelete: Cascade)
  topics         Topic[]
  chapters       Chapter[]
  mainsQuestions MainsQuestion[]

  @@unique([examId, code])
  @@index([examId, publishStatus, sortOrder])
  @@map("subjects")
}

model Topic {
  id            String        @id @default(uuid()) @db.Uuid
  subjectId     String        @map("subject_id") @db.Uuid
  parentId      String?       @map("parent_id") @db.Uuid
  name          String
  slug          String
  description   String?
  sortOrder     Int           @default(0) @map("sort_order")
  publishStatus PublishStatus @default(DRAFT) @map("publish_status")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  deletedAt     DateTime?     @map("deleted_at")

  subject          Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  parent           Topic?             @relation("TopicHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children         Topic[]            @relation("TopicHierarchy")
  questionMappings QuestionTopicMap[]
  topicProgress    TopicProgress[]
  syllabusNodes    SyllabusNode[]

  @@unique([subjectId, slug])
  @@index([subjectId, parentId, sortOrder])
  @@index([publishStatus])
  @@map("topics")
}

model SyllabusNode {
  id            String        @id @default(uuid()) @db.Uuid
  examId        String        @map("exam_id") @db.Uuid
  topicId       String?       @map("topic_id") @db.Uuid
  parentId      String?       @map("parent_id") @db.Uuid
  title         String
  description   String?
  sortOrder     Int           @default(0) @map("sort_order")
  path          String?
  publishStatus PublishStatus @default(PUBLISHED) @map("publish_status")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  exam     Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  topic    Topic?         @relation(fields: [topicId], references: [id], onDelete: SetNull)
  parent   SyllabusNode?  @relation("SyllabusHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children SyllabusNode[] @relation("SyllabusHierarchy")

  @@index([examId, parentId, sortOrder])
  @@index([topicId])
  @@map("syllabus_nodes")
}

model CutOffRecord {
  id            String   @id @default(uuid()) @db.Uuid
  examId        String   @map("exam_id") @db.Uuid
  year          Int
  category      String
  prelimsCutoff Decimal? @map("prelims_cutoff") @db.Decimal(6, 2)
  mainsCutoff   Decimal? @map("mains_cutoff") @db.Decimal(6, 2)
  finalCutoff   Decimal? @map("final_cutoff") @db.Decimal(6, 2)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([examId, year, category])
  @@index([examId, year])
  @@map("cutoff_records")
}

model ExamInfoSection {
  id            String        @id @default(uuid()) @db.Uuid
  examId        String        @map("exam_id") @db.Uuid
  sectionKey    String        @map("section_key")
  title         String
  content       String
  sortOrder     Int           @default(0) @map("sort_order")
  publishStatus PublishStatus @default(PUBLISHED) @map("publish_status")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([examId, sectionKey])
  @@index([examId, sortOrder])
  @@map("exam_info_sections")
}

// =============================================================================
// 3. LEARNING CONTENT
// =============================================================================

model Chapter {
  id            String            @id @default(uuid()) @db.Uuid
  subjectId     String            @map("subject_id") @db.Uuid
  title         String
  slug          String
  introduction  String?
  sortOrder     Int               @default(0) @map("sort_order")
  publishStatus PublishStatus     @default(DRAFT) @map("publish_status")
  sourceType    ContentSourceType @default(NCERT) @map("source_type")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  deletedAt     DateTime?         @map("deleted_at")

  subject Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@unique([subjectId, slug])
  @@index([subjectId, publishStatus, sortOrder])
  @@map("chapters")
}

model Lesson {
  id            String            @id @default(uuid()) @db.Uuid
  chapterId     String            @map("chapter_id") @db.Uuid
  title         String
  slug          String
  summary       String?
  content       String?
  mindmapUrl    String?           @map("mindmap_url")
  sortOrder     Int               @default(0) @map("sort_order")
  publishStatus PublishStatus     @default(DRAFT) @map("publish_status")
  sourceType    ContentSourceType @default(NCERT) @map("source_type")
  metadata      Json?
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  deletedAt     DateTime?         @map("deleted_at")

  chapter        Chapter          @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  sections       LessonSection[]
  lessonProgress LessonProgress[]
  bookmarks      Bookmark[]

  @@unique([chapterId, slug])
  @@index([chapterId, publishStatus, sortOrder])
  @@map("lessons")
}

model LessonSection {
  id        String   @id @default(uuid()) @db.Uuid
  lessonId  String   @map("lesson_id") @db.Uuid
  title     String?
  content   String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId, sortOrder])
  @@map("lesson_sections")
}

model NcertReference {
  id          String   @id @default(uuid()) @db.Uuid
  classNumber Int      @map("class_number")
  subjectName String   @map("subject_name")
  title       String?
  pdfUrl      String   @map("pdf_url")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([classNumber, subjectName])
  @@index([classNumber, sortOrder])
  @@map("ncert_references")
}

model StudyMaterial {
  id            String            @id @default(uuid()) @db.Uuid
  title         String
  description   String?
  materialType  String            @map("material_type")
  url           String?
  metadata      Json?
  sourceType    ContentSourceType @default(EDITORIAL) @map("source_type")
  publishStatus PublishStatus     @default(DRAFT) @map("publish_status")
  sortOrder     Int               @default(0) @map("sort_order")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  deletedAt     DateTime?         @map("deleted_at")

  @@index([materialType, publishStatus])
  @@map("study_materials")
}

// =============================================================================
// 4. QUESTIONS
// =============================================================================

model Question {
  id            String            @id @default(uuid()) @db.Uuid
  examId        String?           @map("exam_id") @db.Uuid
  type          QuestionType
  text          String
  difficulty    Difficulty        @default(MEDIUM)
  explanation   String?
  sourceType    ContentSourceType @default(EDITORIAL) @map("source_type")
  sourceRef     String?           @map("source_ref")
  sourceYear    Int?              @map("source_year")
  version       Int               @default(1)
  publishStatus PublishStatus     @default(DRAFT) @map("publish_status")
  metadata      Json?
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  deletedAt     DateTime?         @map("deleted_at")

  exam                    Exam?                    @relation(fields: [examId], references: [id], onDelete: SetNull)
  options                 QuestionOption[]
  topicMappings           QuestionTopicMap[]
  tags                    QuestionTag[]
  versions                QuestionVersion[]
  pyqMetadata             PyqMetadata?
  quizQuestions           QuizQuestion[]
  quizAttemptAnswers      QuizAttemptAnswer[]
  questionAttempts        QuestionAttempt[]
  bookmarks               Bookmark[]
  mistakes                Mistake[]
  savedQuestions          SavedQuestion[]
  questionReports         QuestionReport[]
  dailyChallengeQuestions DailyChallengeQuestion[]

  @@index([type, publishStatus])
  @@index([examId, sourceYear])
  @@index([difficulty])
  @@map("questions")
}

model QuestionOption {
  id          String   @id @default(uuid()) @db.Uuid
  questionId  String   @map("question_id") @db.Uuid
  label       String
  text        String
  isCorrect   Boolean  @default(false) @map("is_correct")
  explanation String?
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  question           Question            @relation(fields: [questionId], references: [id], onDelete: Cascade)
  quizAttemptAnswers QuizAttemptAnswer[]
  questionAttempts   QuestionAttempt[]

  @@unique([questionId, label])
  @@index([questionId, sortOrder])
  @@map("question_options")
}

model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  category  String?
  createdAt DateTime @default(now()) @map("created_at")

  questionTags QuestionTag[]
  articleTags  ArticleTag[]

  @@index([category])
  @@map("tags")
}

model QuestionTag {
  questionId String @map("question_id") @db.Uuid
  tagId      String @map("tag_id") @db.Uuid

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([questionId, tagId])
  @@map("question_tags")
}

model QuestionTopicMap {
  questionId String @map("question_id") @db.Uuid
  topicId    String @map("topic_id") @db.Uuid

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  topic    Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([questionId, topicId])
  @@index([topicId])
  @@map("question_topic_maps")
}

model QuestionVersion {
  id         String   @id @default(uuid()) @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  version    Int
  snapshot   Json
  changeNote String?  @map("change_note")
  createdBy  String?  @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, version])
  @@map("question_versions")
}

// =============================================================================
// 5. PYQs
// =============================================================================

model PyqMetadata {
  id             String   @id @default(uuid()) @db.Uuid
  questionId     String   @unique @map("question_id") @db.Uuid
  examYear       Int      @map("exam_year")
  paper          GsPaper
  questionNumber Int?     @map("question_number")
  wordLimit      Int?     @map("word_limit")
  marks          Decimal? @db.Decimal(5, 2)
  modelAnswer    String?  @map("model_answer")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([examYear, paper])
  @@map("pyq_metadata")
}

// =============================================================================
// 6. QUIZZES
// =============================================================================

model Quiz {
  id               String        @id @default(uuid()) @db.Uuid
  examId           String?       @map("exam_id") @db.Uuid
  title            String
  description      String?
  quizType         QuizType      @map("quiz_type")
  timeLimitSeconds Int?          @map("time_limit_seconds")
  questionCount    Int           @default(0) @map("question_count")
  publishStatus    PublishStatus @default(DRAFT) @map("publish_status")
  metadata         Json?
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  deletedAt        DateTime?     @map("deleted_at")

  exam      Exam?          @relation(fields: [examId], references: [id], onDelete: SetNull)
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([quizType, publishStatus])
  @@map("quizzes")
}

model QuizQuestion {
  quizId     String @map("quiz_id") @db.Uuid
  questionId String @map("question_id") @db.Uuid
  sortOrder  Int    @default(0) @map("sort_order")

  quiz     Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@id([quizId, questionId])
  @@index([quizId, sortOrder])
  @@map("quiz_questions")
}

model QuizAttempt {
  id               String            @id @default(uuid()) @db.Uuid
  userId           String            @map("user_id") @db.Uuid
  quizId           String            @map("quiz_id") @db.Uuid
  status           QuizAttemptStatus @default(IN_PROGRESS)
  correctCount     Int               @default(0) @map("correct_count")
  incorrectCount   Int               @default(0) @map("incorrect_count")
  totalQuestions   Int               @default(0) @map("total_questions")
  score            Decimal           @default(0) @db.Decimal(8, 2)
  accuracy         Decimal           @default(0) @db.Decimal(5, 2)
  timeTakenSeconds Int?              @map("time_taken_seconds")
  startedAt        DateTime          @default(now()) @map("started_at")
  completedAt      DateTime?         @map("completed_at")
  metadata         Json?

  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz    Quiz                @relation(fields: [quizId], references: [id], onDelete: Restrict)
  answers QuizAttemptAnswer[]

  @@index([userId, completedAt(sort: Desc)])
  @@index([quizId, userId])
  @@index([userId, status])
  @@map("quiz_attempts")
}

model QuizAttemptAnswer {
  id               String   @id @default(uuid()) @db.Uuid
  attemptId        String   @map("attempt_id") @db.Uuid
  questionId       String   @map("question_id") @db.Uuid
  selectedOptionId String?  @map("selected_option_id") @db.Uuid
  isCorrect        Boolean  @default(false) @map("is_correct")
  timeTakenSeconds Int?     @map("time_taken_seconds")
  answeredAt       DateTime @default(now()) @map("answered_at")

  attempt        QuizAttempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       Question        @relation(fields: [questionId], references: [id], onDelete: Restrict)
  selectedOption QuestionOption? @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@map("quiz_attempt_answers")
}

// =============================================================================
// 7. PROGRESS
// =============================================================================

model QuestionAttempt {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  questionId       String   @map("question_id") @db.Uuid
  selectedOptionId String?  @map("selected_option_id") @db.Uuid
  isCorrect        Boolean  @map("is_correct")
  timeTakenSeconds Int?     @map("time_taken_seconds")
  attemptedAt      DateTime @default(now()) @map("attempted_at")

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  question       Question        @relation(fields: [questionId], references: [id], onDelete: Restrict)
  selectedOption QuestionOption? @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  @@index([userId, attemptedAt(sort: Desc)])
  @@index([userId, questionId])
  @@index([userId, isCorrect])
  @@map("question_attempts")
}

