# =============================================================================
# Aarambh360 Backend — Environment Variables
# Copy to .env for local development. NEVER commit real credentials.
# =============================================================================

# --- Core (all environments) ---
NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/aarambh360?schema=public"

# --- CORS ---
# Development: omit to allow all origins
# Staging/Production: comma-separated exact origins (required in production)
# CORS_ORIGIN=https://admin.aarambh360.com,https://staging.aarambh360.com

# =============================================================================
# DEVELOPMENT (local Docker Postgres + dev stubs)
# =============================================================================

# Local PostgreSQL via Docker:
#   docker compose up -d postgres
#   pnpm --filter @aarambh360/backend db:migrate:deploy
#   pnpm --filter @aarambh360/backend db:seed

# Firebase Admin — option A: full service account JSON on one line
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"aarambh360-97dfe",...}

# Firebase Admin — option C: path to service account JSON file (recommended for local dev)
# FIREBASE_SERVICE_ACCOUNT_PATH=C:/path/to/aarambh360-97dfe-service-account.json

# Firebase Admin — option B: individual fields
FIREBASE_PROJECT_ID=aarambh360-97dfe
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@aarambh360-97dfe.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# RTDB extraction (Step 5 — one-time migration tooling)
# FIREBASE_DATABASE_URL=https://aarambh360-97dfe-default-rtdb.firebaseio.com
# LEGACY_RTD_EXPORT_PATH=../../legacy-data/rtdb-export.json

# Cloudflare R2 (Step 10) — required for Mains image upload in non-dev flows
# R2_BUCKET=aarambh360-assets
# R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_BASE_URL=https://assets.aarambh360.com

# Mains OCR (Step 11) — uses OPENAI_API_KEY when set; otherwise dev-stub provider
# OPENAI_API_KEY=

# Mains AI Evaluation + RAG embeddings (Steps 12–13)
# AI_PROVIDER=dev
# AI_PROVIDER=gemini
# AI_PROVIDER=openai
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash

# Subscriptions / Razorpay (Step 16) — dev provider used when keys absent
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_PLAN_PLUS=
# RAZORPAY_PLAN_PREMIUM=

# AdMob server config (Step 17)
# ADMOB_TEST_MODE=true
# ADMOB_BANNER_UNIT_ID=
# ADMOB_INTERSTITIAL_UNIT_ID=

# =============================================================================
# STAGING (set NODE_ENV=production, use staging credentials)
# =============================================================================
# NODE_ENV=production
# DATABASE_URL=postgresql://<user>:<pass>@<staging-host>:5432/aarambh360
# CORS_ORIGIN=https://staging-admin.aarambh360.com
# All integration keys above with staging values
# RAZORPAY_WEBHOOK_SECRET=<staging webhook secret from Razorpay dashboard>

# =============================================================================
# PRODUCTION (set NODE_ENV=production, use production credentials)
# =============================================================================
# NODE_ENV=production
# DATABASE_URL=postgresql://<user>:<pass>@<prod-host>:5432/aarambh360
# CORS_ORIGIN=https://admin.aarambh360.com
# FIREBASE_SERVICE_ACCOUNT or FIREBASE_SERVICE_ACCOUNT_PATH (production project)
# R2_* production bucket credentials
# OPENAI_API_KEY / GEMINI_API_KEY (production AI)
# RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET / RAZORPAY_WEBHOOK_SECRET (live mode)
# ADMOB_* production unit IDs
# Swagger is automatically disabled when NODE_ENV=production
