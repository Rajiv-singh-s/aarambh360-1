{
  "name": "@aarambh360/backend",
  "version": "1.0.0",
  "private": true,
  "description": "Aarambh360 NestJS Backend API",
  "scripts": {
    "build": "pnpm --filter @aarambh360/types build && prisma generate && prisma migrate deploy && nest build",
    "prestart:dev": "pnpm --filter @aarambh360/types build",
    "start": "pnpm --filter @aarambh360/types build && nest start",
    "start:dev": "pnpm --filter @aarambh360/types build && nest start --watch",
    "start:prod": "node dist/main",
    "lint": "echo 'No lint specified yet'",
    "typecheck": "pnpm --filter @aarambh360/types build && tsc --noEmit",
    "test": "pnpm --filter @aarambh360/types build && jest",
    "test:watch": "jest --watch",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:format": "prisma format",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "extract:rtdb": "ts-node --transpile-only scripts/extract-rtdb.ts",
    "validate:seed": "ts-node --transpile-only scripts/validate-seed.ts",
    "rag:ingest": "ts-node --transpile-only scripts/rag-ingest.ts",
    "seed:subscriptions": "ts-node --transpile-only scripts/seed-subscriptions.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aarambh360/types": "workspace:*",
    "@aws-sdk/client-s3": "^3.787.0",
    "@aws-sdk/s3-request-presigner": "^3.787.0",
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "cache-manager": "^7.2.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "express": "^5.2.1",
    "firebase-admin": "^13.4.0",
    "openai": "^7.4.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@prisma/config": "^7.9.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "prisma": "^7.9.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
